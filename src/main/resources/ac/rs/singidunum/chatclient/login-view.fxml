<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ac.rs.singidunum.chatclient.controllers.LoginController">
   <children>
      <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Chat Application" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="32.0" />
               </font>
            </Label>
            <Label text="User Login" textAlignment="CENTER">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <VBox prefWidth="100.0" spacing="10.0">
               <children>
                  <Label text="Password:" />
                  <PasswordField fx:id="passwordField" promptText="Enter your password" />
               </children>
            </VBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="loginButton" mnemonicParsing="false" onAction="#onLoginClick" prefWidth="100.0" text="Login" />
                  <Button mnemonicParsing="false" onAction="#onClearClick" prefWidth="100.0" text="Clear" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="Don't have an account?" />
                  <Button mnemonicParsing="false" onAction="#onRegisterClick" style="-fx-text-fill: #0066cc;" text="Register here" underline="true" />
               </children>
            </HBox>
            <Label fx:id="errorLabel" textAlignment="CENTER" wrapText="true" />
            <Label fx:id="statusLabel" textAlignment="CENTER" wrapText="true" />
         </children>
         <padding>
            <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
