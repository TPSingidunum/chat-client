<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="408.0" prefWidth="460.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ac.rs.singidunum.chatclient.controllers.RegisterController">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="449.0" prefWidth="460.0" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Chat Application" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="32.0" />
               </font>
            </Label>
            <Label text="Create a New Account" textAlignment="CENTER">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <VBox prefWidth="100.0" spacing="5.0">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Username:" />
                  <TextField fx:id="usernameField" promptText="Choose a username (min. 3 characters)" />
               </children>
            </VBox>
            <VBox prefWidth="100.0" spacing="5.0">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Email:" />
                  <TextField fx:id="emailField" promptText="Enter your email address" />
               </children>
            </VBox>
            <VBox prefWidth="100.0" spacing="5.0">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Password:" />
                  <PasswordField fx:id="passwordField" promptText="Enter password (min. 6 characters)" />
               </children>
            </VBox>
            <VBox prefWidth="100.0" spacing="5.0">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Confirm Password:" />
                  <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" />
               </children>
            </VBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onRegisterClick" prefWidth="120.0" text="Register" />
                  <Button mnemonicParsing="false" onAction="#onClearClick" prefWidth="120.0" text="Clear" />
                  <Button mnemonicParsing="false" onAction="#onBackClick" prefWidth="120.0" text="Back to Login" />
               </children>
            </HBox>
            <Label fx:id="messageLabel" textAlignment="CENTER" wrapText="true" />
         </children>
         <padding>
            <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
