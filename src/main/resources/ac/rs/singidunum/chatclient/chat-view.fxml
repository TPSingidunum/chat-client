<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ac.rs.singidunum.chatclient.controllers.ChatController">
    <children>
        <VBox spacing="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <children>

                <!-- Top bar -->
                <HBox alignment="CENTER_LEFT" spacing="10.0"
                      style="-fx-background-color: #2b2b2b; -fx-padding: 8 12 8 12;">
                    <children>
                        <Label text="Chat Application" style="-fx-text-fill: white;">
                            <font><Font name="System Bold" size="16.0"/></font>
                        </Label>
                        <Label fx:id="statusLabel"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 11;"
                               text="Connected"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Button fx:id="logoutButton" text="Logout"
                                onAction=""
                                style="-fx-font-size: 11;"/>
                    </children>
                </HBox>

                <!-- Main content -->
                <SplitPane dividerPositions="0.25" VBox.vgrow="ALWAYS">
                    <items>

                        <!-- Left panel: conversation/contact list -->
                        <VBox minWidth="160.0" spacing="6.0">
                            <children>
                                <Label text="Conversations" style="-fx-font-weight: bold; -fx-padding: 6 8 2 8;"/>
                                <ListView fx:id="conversationList" VBox.vgrow="ALWAYS"/>
                            </children>
                        </VBox>

                        <!-- Right panel: message area -->
                        <VBox spacing="0.0">
                            <children>

                                <!-- Message list -->
                                <ListView fx:id="messageList" VBox.vgrow="ALWAYS"/>

                                <!-- Input row -->
                                <HBox spacing="8.0" style="-fx-padding: 8;">
                                    <children>
                                        <TextField fx:id="messageInput"
                                                   promptText="Type a message…"
                                                   HBox.hgrow="ALWAYS"
                                                   onAction="#onSendClick"/>
                                        <Button text="Send" onAction="#onSendClick"
                                                prefWidth="70.0"/>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                    </items>
                </SplitPane>

            </children>
        </VBox>
    </children>
</AnchorPane>
